# Nothing derived is written to data/: the notebooks rebuild every table from
# the committed raw zip in memory. These patterns stop accidental copies.
data/*.parquet
data/*.csv
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/
.virtual_documents/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
